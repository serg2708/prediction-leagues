# ─────────────────────────────────────────────────────────────
# Prediction Leagues — environment variables
# Copy to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
# Public URL — used in metadata, notifications, and Farcaster manifest
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_PROJECT_NAME=prediction-leagues

# ── OnchainKit (Coinbase Developer Platform) ──────────────────
# Get at: https://portal.cdp.coinbase.com/products/onchainkit
NEXT_PUBLIC_ONCHAINKIT_API_KEY=
# Builder code — shown in Coinbase wallet for smart wallet flows
NEXT_PUBLIC_BUILDER_CODE=

# ── Supabase ──────────────────────────────────────────────────
# Get at: https://supabase.com → project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# ── Smart contract ────────────────────────────────────────────
# Address of deployed PredictionPoolFee.sol
NEXT_PUBLIC_POOL_ADDRESS=0x0000000000000000000000000000000000000000
# 84532 = Base Sepolia (testnet), 8453 = Base mainnet
NEXT_PUBLIC_CHAIN_ID=84532

# ── Sports data APIs ──────────────────────────────────────────
# Football: free key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# CS2/Esports: free key at https://pandascore.co (1000 req/hour)
PANDASCORE_API_KEY=
# NBA: via RapidAPI → nba-api-free-data.p.rapidapi.com
# Get at: https://rapidapi.com/api-sports/api/nba-api-free-data
RAPIDAPI_KEY=

# ── API secrets ───────────────────────────────────────────────
# Generate with: openssl rand -hex 24

# Protect admin routes (/api/admin/*, /api/matches/*/result)
ADMIN_SECRET=

# Protect /api/notify
NOTIFY_SECRET=

# Protect /api/cron/* — Vercel sends this as Bearer token
CRON_SECRET=

# ── Webhooks ──────────────────────────────────────────────────
# Farcaster frame webhook HMAC secret (from Farcaster app settings)
FARCASTER_WEBHOOK_SECRET=
# PandaScore webhook HMAC secret (optional — requires paid plan)
PANDASCORE_WEBHOOK_SECRET=

# ── On-chain payout signer ────────────────────────────────────
# Hot wallet that calls payout() on PredictionPoolFee
# NEVER expose this key client-side — keep it server-only
# Use a dedicated wallet funded only with enough ETH for gas
POOL_SIGNER_PRIVATE_KEY=

# Optional: custom RPC URL (Alchemy / Infura). Defaults to public Base RPC.
RPC_URL=
